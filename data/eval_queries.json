{
  "_meta": {
    "note": "Hand-written held-out queries with expected constraints. Gold set per query = every product in the catalog that genuinely satisfies the expected constraints (computed deterministically at eval time). expect_none queries must yield an honest no-match instead of padded picks."
  },
  "queries": [
