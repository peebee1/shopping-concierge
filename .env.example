# Copy to .env (or export) to use a real LLM for ranking.
# Any OpenAI-compatible endpoint works: OpenAI, OpenRouter, Groq, vLLM, Ollama, ...

# API key for the LLM provider
SHOPCON_API_KEY=sk-...

# Base URL for OpenAI-compatible chat completions
# (defaults to https://api.openai.com/v1 if unset)
SHOPCON_BASE_URL=

# Model name (default: gpt-4o-mini). Cheap flash-tier models recommended —
# the pipeline only makes 2 LLM calls per query.
SHOPCON_MODEL=

# Max output tokens per LLM call (default 6000 — reasoning models burn budget
# on hidden reasoning before the visible answer).
SHOPCON_MAX_TOKENS=

# Region code (US, IN, DE, GB, JP, ...). CLI default: locale detection.
SHOPCON_REGION=

# Set to 1 to refresh FX rates from frankfurter.app (keyless) at startup.
SHOPCON_LIVE_FX=

# Catalog data older than this many days is labeled "stale" (default 7).
SHOPCON_MAX_AGE_DAYS=
